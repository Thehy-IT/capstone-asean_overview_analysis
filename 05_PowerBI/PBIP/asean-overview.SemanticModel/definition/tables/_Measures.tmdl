	measure 'KPI Status Flag' = ```
			
			VAR _YoY = [Indicator Value YoY %]
			RETURN
			SWITCH(
			    TRUE(),
			    _YoY > 0.02, 1,
			    _YoY < -0.02, -1,
			    0
			)
			
			```
