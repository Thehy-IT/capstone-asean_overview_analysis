	measure 'Indicator Value PY' = ```
			
			CALCULATE(
			    [Total Indicator Value],
			    SAMEPERIODLASTYEAR(Dim_Date[Date])
			)
			
			```
		formatString: #,##0.00
		displayFolder: 12 Time Intelligence
		lineageTag: 4f9cb9d9-e478-48d2-99c6-3800f08bcb4f

	measure 'Indicator Value YoY Change' = ```
			
			VAR _Current = [Total Indicator Value]
			VAR _Previous = [Indicator Value PY]
			RETURN
			IF(
			    NOT ISBLANK(_Current) && NOT ISBLANK(_Previous),
			    _Current - _Previous,
			    BLANK()
			)
			
			```
		formatString: #,##0.00
		displayFolder: 12 Time Intelligence
		lineageTag: 85159aa2-ffd5-428d-8634-f6288b8334d6

	measure 'Indicator Value YoY %' = ```
			
			VAR _Current = [Total Indicator Value]
			VAR _Previous = [Indicator Value PY]
			RETURN
			DIVIDE(
			    _Current - _Previous,
			    _Previous,
			    0
			)
			
			```
		formatString: 0.00%
		displayFolder: 12 Time Intelligence
		lineageTag: 324600ce-7192-4136-88c0-4ee76790f9b2

	measure 'GDP PY' = ```
			
			CALCULATE(
			    [GDP (Current US$)],
			    SAMEPERIODLASTYEAR(Dim_Date[Date])
			)
			
			```
		formatString: #,##0
		displayFolder: 12 Time Intelligence
		lineageTag: 22c6e2e4-75fd-4f7d-bc62-2eb832b9d26f

	measure 'GDP YoY %' = ```
			
			VAR _CurrentGDP = [GDP (Current US$)]
			VAR _PreviousGDP = [GDP PY]
			RETURN
			DIVIDE(_CurrentGDP - _PreviousGDP, _PreviousGDP, 0)
			
			```
		formatString: 0.00%
		displayFolder: 12 Time Intelligence
		lineageTag: d04d84d5-bf47-4e23-b695-9e53982ce656

	measure 'Internet Users YoY Change' = ```
			
			VAR _Current = [Internet Users (% Pop)]
			VAR _Previous = CALCULATE([Internet Users (% Pop)], SAMEPERIODLASTYEAR(Dim_Date[Date]))
			RETURN
			IF(NOT ISBLANK(_Current) && NOT ISBLANK(_Previous), _Current - _Previous, BLANK())
			
			```
		formatString: 0.00
		displayFolder: 12 Time Intelligence
		lineageTag: 4fac4e2b-5a95-4f81-a386-d3046d2cf6be

	measure 'GDP Rank ASEAN' = ```
			
			IF(
			    ISINSCOPE(Dim_Country[CountryName]),
			    RANKX(
			        ALLSELECTED(Dim_Country),
			        [GDP (Current US$)],
			        ,
			        DESC,
			        Dense
			    ),
			    BLANK()
			)
			
			```
		formatString: 0
		displayFolder: 13 Ranking
		lineageTag: 51034b78-d6a5-4456-9f03-4af00d3e6515

	measure 'GDP Share of ASEAN (%)' = ```
			
			VAR _CountryGDP = [GDP (Current US$)]
			VAR _TotalASEANGDP = CALCULATE([GDP (Current US$)], ALL(Dim_Country))
			RETURN
			DIVIDE(_CountryGDP, _TotalASEANGDP, 0)
			
			```
		formatString: 0.00%
		displayFolder: 13 Ranking
		lineageTag: 762e6a7a-79a6-442c-abc6-12abc55e5088

	measure 'GDP Share Top 3 (%)' = ```
			
			VAR _Top3GDP = 
			    SUMX(
			        TOPN(
			            3,
			            ALLSELECTED(Dim_Country),
			            [GDP (Current US$)],
			            DESC
			        ),
			        [GDP (Current US$)]
			    )
			VAR _TotalASEANGDP = CALCULATE([GDP (Current US$)], ALL(Dim_Country))
			RETURN
			DIVIDE(_Top3GDP, _TotalASEANGDP, 0)
			
			```
		formatString: 0.00%
		displayFolder: 13 Ranking
		lineageTag: f1c9c4de-99d1-4a7a-827b-31548126349a

	measure 'Country Delta vs ASEAN Avg' = ```
			
			VAR _CountryVal = [Avg Indicator Value]
			VAR _ASEANAvg = CALCULATE([Avg Indicator Value], ALL(Dim_Country))
			RETURN
			_CountryVal - _ASEANAvg
			
			```
		formatString: #,##0.00
		displayFolder: 13 Ranking
		lineageTag: 21503fc0-71bb-4471-a8ff-d4af7a128a73

	measure 'Dynamic Dashboard Title' = ```
			
			VAR _SelectedDomain = SELECTEDVALUE(Dim_Indicator[Domain], "Tất cả 10 Mảng Phát Triển")
			VAR _SelectedCountry = SELECTEDVALUE(Dim_Country[CountryName], "Toàn khối ASEAN")
			VAR _SelectedYear = SELECTEDVALUE(Dim_Date[Year], "Giai đoạn 2015-2025")
			RETURN
			"Báo cáo Phát triển: " & _SelectedDomain & " | " & _SelectedCountry & " (" & _SelectedYear & ")"
			
			```
