table Dim_Date
	lineageTag: 37f5fd4b-87df-430a-98ea-1458a52876e0
	dataCategory: Time

	column Date
		isUnique
		isKey
		formatString: General Date
		lineageTag: a5400e67-ec52-4509-a86a-d97bd5488577
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 66c68ae5-ef07-4c71-856c-c5472ea4aef2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column YearLabel
		lineageTag: e8f6209a-bacf-4f7d-bd86-342cad912be3
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearLabel]

		annotation SummarizationSetBy = Automatic

	column Decade
		lineageTag: 1089cf27-184c-4d30-aa47-0063505cbadb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Decade]

		annotation SummarizationSetBy = Automatic

	column Period
		lineageTag: 518e9a32-5f72-4f5e-ab46-d1bd1bc7c979
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period]

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source = ```
				
				    ADDCOLUMNS(                                                                                                                                  
				        CALENDAR(DATE(2015, 1, 1), DATE(2025, 12, 31)),                                                                                          
				        "Year", YEAR([Date]),                                                                                                                    
				        "YearLabel", "Năm " & YEAR([Date]),                                                                                                      
				        "Decade", IF(YEAR([Date]) < 2020, "Thập kỷ 2010s", "Thập kỷ 2020s"),                                                                     
				        "Period", IF(YEAR([Date]) <= 2020, "2015-2020", "2021-2025")                                                                             
				    )
				```

	annotation PBI_Id = 1a7719dffe794cde9b9a6e4247a389f3

