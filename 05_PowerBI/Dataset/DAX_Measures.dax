// =========================================================================
// POWER BI DAX MEASURE LIBRARY (ENTERPRISE PRODUCTION-GRADE - ULTRA-STRICT REFACTORED)
// Project: ASEAN Socio-Economic & Development Analysis (2015 - 2025)
// Author: 20-Year Senior BI Solution Architect
// Description: Comprehensive DAX Measure definitions covering 10 Socio-Economic 
//              Domains, Time Intelligence, Dynamic KPI Headers, Benchmarking,
//              and Power BI Star Schema Optimization. Rigorously Refactored for
//              Stock vs Flow, Role-Playing Relationships, Context-Aware Benchmarks,
//              Multi-Select Dynamic Headers, and Indicator Polarity.
// =========================================================================


// =========================================================================
// SECTION 1: CORE AGGREGATIONS & GENERIC BASE MEASURES
// =========================================================================

// Total Record Count in Fact Table
[Total Records] = 
COUNTROWS(Fact_ASEAN_Indicators)

// Total Value (Generic Aggregate Sum - Note: Only meaningful when filtered to a single indicator)
[Total Indicator Value] = 
SUM(Fact_ASEAN_Indicators[Value])

// Average Value (Generic Aggregate Average)
[Avg Indicator Value] = 
AVERAGE(Fact_ASEAN_Indicators[Value])

// Minimum Indicator Value
[Min Indicator Value] = 
MIN(Fact_ASEAN_Indicators[Value])

// Maximum Indicator Value
[Max Indicator Value] = 
MAX(Fact_ASEAN_Indicators[Value])


// =========================================================================
// SECTION 2: ECONOMIC & GDP DOMAIN MEASURES (7 INDICATORS)
// =========================================================================

// 1. GDP (Current US$)
[GDP (Current US$)] = 
CALCULATE(
    SUM(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "NY.GDP.MKTP.CD"
)

// 2. GDP Growth Rate (%)
[GDP Growth Rate (%)] = 
CALCULATE(
    AVERAGE(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "NY.GDP.MKTP.KD.ZG"
)

// 3. GDP Per Capita (Current US$)
[GDP Per Capita (US$)] = 
CALCULATE(
    AVERAGE(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "NY.GDP.PCAP.CD"
)

// 4. Inflation Rate (% Consumer Prices)
[Inflation Rate (%)] = 
CALCULATE(
    AVERAGE(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "FP.CPI.TOTL.ZG"
)

// 5. Central Government Debt (% of GDP)
[Government Debt (% GDP)] = 
CALCULATE(
    AVERAGE(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "GC.DOD.TOTL.GD.ZS"
)

// 6. Gross Capital Formation (% of GDP)
[Gross Capital Formation (% GDP)] = 
CALCULATE(
    AVERAGE(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "NE.GDI.TOTL.ZS"
)

// 7. Gross Savings (% of GDP)
[Gross Savings (% GDP)] = 
CALCULATE(
    AVERAGE(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "NY.GNS.ICTR.ZS"
)


// =========================================================================
// SECTION 3: DEMOGRAPHICS & POPULATION DOMAIN MEASURES (13 INDICATORS)
// =========================================================================

// 1. Total Population (Stock Measure: Evaluates for Latest Selected Year)
[Total Population] = 
VAR _LatestYear = MAX(Dim_Date[Year])
RETURN
CALCULATE(
    SUM(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "SP.POP.TOTL",
    Dim_Date[Year] = _LatestYear
)

// 2. Population Growth Rate (%)
[Population Growth Rate (%)] = 
CALCULATE(
    AVERAGE(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "SP.POP.GROW"
)

