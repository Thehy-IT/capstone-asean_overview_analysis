// =========================================================================
// SECTION 12: TIME INTELLIGENCE & YOY COMPARATIVE MEASURES (ANNUAL GRAIN REFACTORED)
// =========================================================================

// Generic Prior Year Value (Annual Grain Time Intelligence)
[Indicator Value PY] = 
VAR _CurrentYear = MAX(Dim_Date[Year])
RETURN
CALCULATE(
    [Total Indicator Value],
    ALL(Dim_Date),
    Dim_Date[Year] = _CurrentYear - 1
)

// Generic Year-over-Year (YoY) Difference Change
[Indicator Value YoY Change] = 
VAR _Current = [Total Indicator Value]
VAR _Previous = [Indicator Value PY]
RETURN
IF(
    NOT ISBLANK(_Current) && NOT ISBLANK(_Previous),
    _Current - _Previous,
    BLANK()
)

// Generic Year-over-Year (YoY) Percentage Growth (Safe Divide with BLANK Handling)
[Indicator Value YoY %] = 
VAR _Current = [Total Indicator Value]
VAR _Previous = [Indicator Value PY]
RETURN
IF(
    NOT ISBLANK(_Current) && NOT ISBLANK(_Previous),
    DIVIDE(_Current - _Previous, _Previous),
    BLANK()
)

// GDP Prior Year (Annual Grain Time Intelligence)
[GDP PY] = 
VAR _CurrentYear = MAX(Dim_Date[Year])
RETURN
CALCULATE(
    [GDP (Current US$)],
    ALL(Dim_Date),
    Dim_Date[Year] = _CurrentYear - 1
)

// GDP YoY Growth Percentage (Safe Divide without Forced 0)
[GDP YoY %] = 
VAR _CurrentGDP = [GDP (Current US$)]
VAR _PreviousGDP = [GDP PY]
RETURN
IF(
    NOT ISBLANK(_CurrentGDP) && NOT ISBLANK(_PreviousGDP),
    DIVIDE(_CurrentGDP - _PreviousGDP, _PreviousGDP),
    BLANK()
)

// Internet Users YoY Change (% Points)
[Internet Users YoY Change] = 
VAR _CurrentYear = MAX(Dim_Date[Year])
VAR _Current = [Internet Users (% Pop)]
VAR _Previous = CALCULATE(
    [Internet Users (% Pop)],
    ALL(Dim_Date),
    Dim_Date[Year] = _CurrentYear - 1
)
RETURN
IF(NOT ISBLANK(_Current) && NOT ISBLANK(_Previous), _Current - _Previous, BLANK())


// =========================================================================
// SECTION 13: RANKING & BENCHMARKING (DYNAMIC BENCHMARKS ACROSS ASEAN)
// =========================================================================

// Country GDP Rank within ASEAN (Flexibly Handles Country Code & Name Scope)
[GDP Rank ASEAN] = 
IF(
    HASONEVALUE(Dim_Country[CountryCode]) || HASONEVALUE(Dim_Country[CountryName]),
    RANKX(
        ALLSELECTED(Dim_Country),
        [GDP (Current US$)],
        ,
        DESC,
        Dense
    ),
    BLANK()
)

// Country GDP Share of Total Filtered ASEAN (%) (Respects SubRegion Slicers via ALLSELECTED)
[GDP Share of ASEAN (%)] = 
VAR _CountryGDP = [GDP (Current US$)]
VAR _TotalASEANGDP = CALCULATE([GDP (Current US$)], ALLSELECTED(Dim_Country))
RETURN
IF(
    NOT ISBLANK(_CountryGDP) && NOT ISBLANK(_TotalASEANGDP),
    DIVIDE(_CountryGDP, _TotalASEANGDP),
    BLANK()
)

// Top 3 ASEAN GDP Share Combined (%) (Safe Divide Handling)
[GDP Share Top 3 (%)] = 
VAR _Top3GDP = 
    SUMX(
        TOPN(
            3,
            ALLSELECTED(Dim_Country),
            [GDP (Current US$)],
            DESC
        ),
        [GDP (Current US$)]
    )
VAR _TotalASEANGDP = CALCULATE([GDP (Current US$)], ALLSELECTED(Dim_Country))
RETURN
IF(
    NOT ISBLANK(_Top3GDP) && NOT ISBLANK(_TotalASEANGDP),
    DIVIDE(_Top3GDP, _TotalASEANGDP),
    BLANK()
)

// Country Indicator Value Delta vs ASEAN Average (Respects SubRegion Slicers via ALLSELECTED)
[Country Delta vs ASEAN Avg] = 
VAR _CountryVal = [Avg Indicator Value]
VAR _ASEANAvg = CALCULATE([Avg Indicator Value], ALLSELECTED(Dim_Country))
RETURN
IF(
    NOT ISBLANK(_CountryVal) && NOT ISBLANK(_ASEANAvg),
    _CountryVal - _ASEANAvg,
    BLANK()
)


// =========================================================================
// SECTION 14: DYNAMIC KPI HEADERS & UI HELPER MEASURES
// =========================================================================

// Dynamic Title for Dashboard Visuals (Handles Single-Select, Multi-Select & All-Select)
[Dynamic Dashboard Title] = 
VAR _SelectedDomain = SELECTEDVALUE(Dim_Indicator[Domain], "Tất cả 10 Mảng Phát Triển")
VAR _CountryCount = COUNTROWS(VALUES(Dim_Country[CountryName]))
VAR _TotalCountries = CALCULATE(COUNTROWS(Dim_Country), ALL(Dim_Country))
VAR _SelectedCountryText = 
    SWITCH(
        TRUE(),
        _CountryCount = 1, SELECTEDVALUE(Dim_Country[CountryName]),
        _CountryCount < _TotalCountries, _CountryCount & " Quốc gia được chọn",
        "Toàn khối ASEAN"
    )
VAR _SelectedYear = SELECTEDVALUE(Dim_Date[Year], "Giai đoạn 2015-2025")
RETURN
"Báo cáo Phát triển: " & _SelectedDomain & " | " & _SelectedCountryText & " (" & _SelectedYear & ")"

// Selected Indicator Display Name
[Selected Indicator Name] = 
SELECTEDVALUE(Dim_Indicator[SeriesName], "Vui lòng chọn 1 chỉ số cụ thể")

// Selected Country Display Name (Handles Multi-Select)
[Selected Country Name] = 
VAR _CountryCount = COUNTROWS(VALUES(Dim_Country[CountryName]))
VAR _TotalCountries = CALCULATE(COUNTROWS(Dim_Country), ALL(Dim_Country))
RETURN
SWITCH(
    TRUE(),
    _CountryCount = 1, SELECTEDVALUE(Dim_Country[CountryName]),
    _CountryCount < _TotalCountries, _CountryCount & " Quốc gia được chọn",
    "Khối 10 Nước ASEAN + Timor-Leste"
)

// Dynamic KPI Status Indicator Flag (1 = Positive, -1 = Negative, 0 = Neutral)
// Refactored: Dynamically inverts direction for negative/cost indicators (Unemployment, Inflation, Mortality, CO2, Debt)
[KPI Status Flag] = 
VAR _YoY = [Indicator Value YoY %]
VAR _SeriesCode = SELECTEDVALUE(Dim_Indicator[SeriesCode])
VAR _IsInverse = _SeriesCode IN {
    "SL.UEM.TOTL.ZS",    // Total Unemployment Rate
    "SL.UEM.1524.ZS",    // Youth Unemployment Rate
    "FP.CPI.TOTL.ZG",    // Inflation Rate
    "SH.DYN.MORT",       // Under-5 Mortality Rate
    "SH.DYN.MORT.FE",    // Under-5 Female Mortality Rate
    "SH.DYN.MORT.MA",    // Under-5 Male Mortality Rate
    "SH.STA.MMRT",       // Maternal Mortality Ratio (Modeled)
    "SH.STA.MMRT.NE",    // Maternal Mortality Ratio (National)
    "NY.ADJ.DCO2.GN.ZS", // CO2 Damage (% GNI)
    "GC.DOD.TOTL.GD.ZS"  // Government Debt (% GDP)
}
VAR _RawFlag = SWITCH(
    TRUE(),
    _YoY > 0.02, 1,    // Tăng trưởng > +2%
    _YoY < -0.02, -1,  // Suy giảm < -2%
    0                  // Ổn định (-2% đến +2%)
)
RETURN
IF(
    ISBLANK(_YoY), 
    BLANK(), 
    IF(_IsInverse, -1 * _RawFlag, _RawFlag)
)
