// 1. Exports of Goods and Services (Current US$)
[Exports of Goods & Services (US$)] = 
CALCULATE(
    SUM(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "NE.EXP.GNFS.CD"
)

// 2. Imports of Goods and Services (Current US$)
[Imports of Goods & Services (US$)] = 
CALCULATE(
    SUM(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "NE.IMP.GNFS.CD"
)

// 3. Merchandise Exports (Current US$)
[Merchandise Exports (US$)] = 
CALCULATE(
    SUM(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "TX.VAL.MRCH.CD.WT"
)

// 4. Merchandise Imports (Current US$)
[Merchandise Imports (US$)] = 
CALCULATE(
    SUM(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "TM.VAL.MRCH.CD.WT"
)

// Trade Balance (Exports - Imports)
[Trade Balance (US$)] = 
VAR _Exports = [Exports of Goods & Services (US$)]
VAR _Imports = [Imports of Goods & Services (US$)]
RETURN
IF(
    NOT ISBLANK(_Exports) || NOT ISBLANK(_Imports),
    _Exports - _Imports,
    BLANK()
)

// 5. Merchandise Trade (% of GDP)
[Merchandise Trade (% GDP)] = 
CALCULATE(
    AVERAGE(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "TG.VAL.TOTL.GD.ZS"
)

