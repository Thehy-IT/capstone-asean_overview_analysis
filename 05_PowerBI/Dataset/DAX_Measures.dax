// =========================================================================
// SECTION 10: TOURISM & SERVICES DOMAIN MEASURES (1 INDICATOR + FACT FLOW)
// =========================================================================

// 1. Tourism Visitor Arrivals (Aggregated Fact Indicators)
[Tourism Visitors Total] = 
CALCULATE(
    SUM(Fact_ASEAN_Indicators[Value]),
    Dim_Indicator[SeriesCode] = "ST.INT.ARVL.TOTL"
)

// 2. Tourism Visitors Flow - Destination Perspective (Active Relationship)
[Tourism Visitors Flow (Destination)] = 
SUM(Fact_ASEAN_Tourism_Flow[Visitors])

// 3. Tourism Visitors Flow - Origin Perspective (Role-Playing Relationship)
[Tourism Visitors Flow (Origin)] = 
CALCULATE(
    SUM(Fact_ASEAN_Tourism_Flow[Visitors]),
    USERELATIONSHIP(Dim_Country[CountryCode], Fact_ASEAN_Tourism_Flow[OriginCountryCode])
)

// Top Tourism Corridor Flow Visitors
[Top Corridor Visitors] = 
MAXX(
    SUMMARIZE(
        Fact_ASEAN_Tourism_Flow,
        Fact_ASEAN_Tourism_Flow[DestinationCountryCode],
        Fact_ASEAN_Tourism_Flow[OriginCountryCode]
    ),
    [Tourism Visitors Flow (Destination)]
)


