# ==============================================================================
# CAPSTONE ASEAN OVERVIEW ANALYSIS - PRODUCTION .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Power BI & Power BI Project (PBIP) Rules
# ------------------------------------------------------------------------------
# Ignore local user settings, credentials, and cache in PBIP
**/.pbi/localSettings.json
**/.pbi/cache.json
**/.pbi/userSettings.json

# Power BI temporary lock files and backups
*.pbix.bak
*.pbit.bak
~$*.pbix
~$*.pbit

# ------------------------------------------------------------------------------
# 2. Microsoft Office Temporary Lock Files (~$*)
# ------------------------------------------------------------------------------
~$*.docx
~$*.xlsx
~$*.pptx
~$*.doc
~$*.xls
~$*.ppt

# ------------------------------------------------------------------------------
# 3. Python, Virtual Environments & Jupyter Checkpoints
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 4. Databases, Archives & Logs
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.log
*.tmp
*.temp
*.bak
*.zip
*.tar.gz
*.rar

# ------------------------------------------------------------------------------
# 5. OS & Editor Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo
*.user

# ------------------------------------------------------------------------------
# 6. Sensitive Credentials & Environment Variables
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets.json
credentials.json
*.pem
*.key
